SERVICE_NAME=agency-service

SERVICE_VERSION=1.0.0

NODE_ENV=development

PORT=4010

API_PREFIX=/api/v1

##########################################
# DATABASE
##########################################

MONGODB_URI=

MONGODB_DATABASE=agency_service

##########################################
# LOGGING
##########################################

LOG_LEVEL=info

##########################################
# ACCOUNT SERVICE (the only service agency-service calls for business logic)
##########################################
# Base URL for account-service. An agent's float virtual account
# is provisioned through account-service's internal API
# (POST /internal/virtual-accounts), purpose=AGENT_FLOAT.

ACCOUNT_SERVICE_URL=

##########################################
# INTERNAL SERVICE-TO-SERVICE AUTH
##########################################
# Sent as x-internal-token on every account-service call above.
# Must match account-service's own INTERNAL_SERVICE_TOKEN.

INTERNAL_SERVICE_TOKEN=

##########################################
# ADMIN SESSION AUTH (portal-facing routes)
##########################################
# Every /agents route is admin-only. agency-service owns a full
# local admin module (src/modules/admin/), same as
# account-service, kyc-service, onboarding-service, and
# merchant-service - its own POST /admin/auth/login, its own
# in-memory session store. This secret does not need to match
# account-service's; each service's admin sessions are
# independent, same as every other admin-gated service in this
# platform.

ADMIN_JWT_SECRET=

ADMIN_SESSION_TTL_MINUTES=30

ADMIN_INACTIVITY_TIMEOUT_MINUTES=10

##########################################
# FINERACT (admin login only)
##########################################
# The only Fineract touchpoint in this service: authenticating an
# admin login against Fineract's own /authentication endpoint.
# agency-service never calls Fineract for business logic - agent
# cash-in/cash-out transaction execution is explicitly out of
# scope for this service.

FINERACT_URL=

FINERACT_TENANT=

FINERACT_TLS_REJECT_UNAUTHORIZED=false
