# Fineract server root (no /fineract-provider/api/v1 suffix - the
# client appends that itself). Username/password are intentionally
# NOT configured here - VITE_ vars are bundled into the client build
# and would be publicly visible; enter credentials in the Connection
# screen instead.
VITE_FINERACT_API_URL=
VITE_FINERACT_TENANT_ID=default

# KYC Service base URL, including its /api/v1 prefix. Leave empty to
# disable KYC features.
VITE_KYC_API_URL=

# Account Service base URL (Internet Banking Platform), including its
# /api/v1 prefix. Called directly from the browser - not proxied
# through the Fineract gateway. Leave empty to disable Account Number
# generation on savings account creation.
VITE_ACCOUNT_SERVICE_API_URL=
